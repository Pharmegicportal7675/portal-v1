# Hostinger MySQL (required)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# App (required for production)
NEXT_PUBLIC_APP_URL=https://portal.pharmegichealthcare.com

# Optional: Hostinger absolute path when Node cwd differs from public/uploads
# CERTIFICATES_UPLOAD_ROOT=/home/u402838766/domains/portal.pharmegichealthcare.com/nodejs/public/uploads/certificates

# Optional: override remote origin for PO attachment HTTP fallback (defaults to NEXT_PUBLIC_APP_URL)
# PO_ATTACHMENTS_REMOTE_ORIGIN=https://portal.pharmegichealthcare.com

# Optional: secret for POST /api/admin/repair-attachments (live TCC PDF repair after deploy)
# REPAIR_ATTACHMENTS_SECRET=generate-a-long-random-string

# JWT sessions (recommended in production)
AUTH_SECRET=generate-a-long-random-string

# SMTP — optional; primary config is Admin → Settings (admin_settings in MySQL)
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=587
# SMTP_USER=your-smtp2go-user
# SMTP_PASS=your-smtp2go-password
# SMTP_FROM=Pharmegic Healthcare Limited <noreply@pharmegichealthcare.com>
